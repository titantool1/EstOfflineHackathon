# Local development only. setup-local.py generates missing passwords.
COMPOSE_PROJECT_NAME=eco-jupjup-team
POSTGRES_VERSION=18.6-bookworm
POSTGRES_DB=eco
POSTGRES_USER=eco
POSTGRES_PASSWORD=__GENERATE_SECRET__
POSTGRES_PORT=55433

ES_LOCAL_VERSION=9.5.3
ES_LOCAL_PORT=19201
ES_LOCAL_URL=http://127.0.0.1:19201
ES_USERNAME=elastic
ES_LOCAL_PASSWORD=__GENERATE_SECRET__
ES_LOCAL_API_KEY=
ES_LOCAL_JAVA_OPTS="-Xms512m -Xmx512m"
ECO_INDEX_NAME=eco-catalog-v1
ECO_EMBEDDING_MODEL=BAAI/bge-m3
ECO_EMBEDDING_DIMENSIONS=1024

# Optional Compose profile: tools
KIBANA_LOCAL_PORT=15602
KIBANA_LOCAL_PASSWORD=__GENERATE_SECRET__
KIBANA_ENCRYPTION_KEY=__GENERATE_SECRET__

# Web/Spring application and future AI runner ports.
FRONTEND_PORT=3300
BACKEND_PORT=18080
AI_SERVER_PORT=18000
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_API_KEY=
KAKAO_REST_API_KEY=

# Public JavaScript map key; also used by the frontend image build.
NEXT_PUBLIC_KAKAO_MAP_KEY=

# Optional government service API key; never exposed to the browser.
GOV24_API_KEY=
