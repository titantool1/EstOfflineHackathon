# python3 scripts/setup-local.py creates .env with generated local passwords.
COMPOSE_PROJECT_NAME=est-offline-hackathon
ES_LOCAL_VERSION=9.5.3
ES_LOCAL_CONTAINER_NAME=est-offline-elasticsearch
ES_LOCAL_PORT=19200
ES_LOCAL_URL=http://localhost:19200
ES_LOCAL_PASSWORD=__GENERATE_SECRET__
ES_LOCAL_JAVA_OPTS="-Xms512m -Xmx512m"
ES_LOCAL_DISK_SPACE_REQUIRED=5gb
ES_LOCAL_LICENSE=basic
KIBANA_LOCAL_SETTINGS_CONTAINER_NAME=est-offline-kibana-settings
KIBANA_LOCAL_CONTAINER_NAME=est-offline-kibana
KIBANA_LOCAL_PORT=15601
KIBANA_LOCAL_PASSWORD=__GENERATE_SECRET__
KIBANA_ENCRYPTION_KEY=__GENERATE_SECRET__
