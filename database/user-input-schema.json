{
  "status": "design_draft_not_installed",
  "source": "approved input classification and verified catalog action links",
  "storage_mode": "current_known_facts_only",
  "tables": {
    "user_profiles": {
      "primary_key": [
        "user_id"
      ],
      "fields": {
        "user_id": {
          "type": "same_as_auth_user_primary_key",
          "references": "users.id (logical reference, physical identity pending)",
          "nullable": false
        },
        "birth_date": {
          "type": "date",
          "nullable": true
        },
        "observed_at": {
          "type": "timestamptz",
          "meaning": "time of user statement; not historical state reconstruction",
          "nullable": true
        },
        "source_kind": {
          "type": "enum",
          "values": [
            "user_statement"
          ],
          "nullable": true
        }
      },
      "constraints": [
        "birth_date present requires observed_at and source_kind",
        "birth_date absent permits absent metadata"
      ]
    },
    "user_regions": {
      "primary_key": [
        "user_id",
        "relation",
        "region_id"
      ],
      "fields": {
        "user_id": {
          "type": "same_as_auth_user_primary_key",
          "references": "users.id (logical reference, physical identity pending)",
          "nullable": false
        },
        "relation": {
          "type": "enum",
          "values": [
            "registered_residence",
            "work",
            "study",
            "business"
          ],
          "nullable": false
        },
        "region_id": {
          "type": "same_as_region_primary_key",
          "references": "regions.id (reference catalog pending)",
          "nullable": false
        },
        "observed_at": {
          "type": "timestamptz",
          "meaning": "time of user statement; not historical state reconstruction",
          "nullable": false
        },
        "source_kind": {
          "type": "enum",
          "values": [
            "user_statement"
          ],
          "nullable": false
        }
      },
      "constraints": [
        "at most one registered_residence row per user",
        "work/study/business may have multiple regions"
      ]
    },
    "user_memberships": {
      "primary_key": [
        "user_id",
        "service_code"
      ],
      "fields": {
        "user_id": {
          "type": "same_as_auth_user_primary_key",
          "references": "users.id (logical reference, physical identity pending)",
          "nullable": false
        },
        "service_code": {
          "type": "text",
          "references": "services.service_code",
          "nullable": false
        },
        "is_member": {
          "type": "boolean",
          "nullable": false
        },
        "observed_at": {
          "type": "timestamptz",
          "meaning": "time of user statement; not historical state reconstruction",
          "nullable": false
        },
        "source_kind": {
          "type": "enum",
          "values": [
            "user_statement"
          ],
          "nullable": false
        }
      },
      "constraints": [
        "missing row is unknown, not false"
      ]
    }
  },
  "logical_external_references": [
    "users",
    "regions",
    "services"
  ],
  "service_codes": {
